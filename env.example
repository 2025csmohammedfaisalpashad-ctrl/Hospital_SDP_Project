# Copy this file to ".env" in the same folder and fill in real values.
# NEVER commit the real .env file to GitHub.

# All 4 laptops must use the EXACT SAME value here so they all read/write
# the same MongoDB Atlas database.
MONGO_URL=mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/?retryWrites=true&w=majority

# Used to sign login tokens. Any long random string works -- generate one
# with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-this-with-a-long-random-string
